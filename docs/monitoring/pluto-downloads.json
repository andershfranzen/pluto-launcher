{
  "uid": "pluto-downloads",
  "title": "Pluto \u00b7 APK downloads",
  "tags": [
    "pluto",
    "github",
    "downloads"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "Europe/Copenhagen",
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Downloads, not users",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "GitHub APK downloads are a proxy for interest, **not unique users or active installations**. Updates and repeat downloads count again. Collection runs daily around **08:00 Copenhagen time**, independently of T3. Trends begin October 12, 2026; Prometheus retains 30 days. Daily JSON archives remain on the homelab. The 24-hour net change appears after a full day and can drop if assets are removed."
      }
    },
    {
      "id": 2,
      "title": "Total APK downloads",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pluto_github_release_downloads{repository=\"andershfranzen/pluto-launcher\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Latest stable release downloads",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pluto_github_release_downloads{repository=\"andershfranzen/pluto-launcher\",latest=\"true\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Net change over 24 hours",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pluto_github_release_downloads{repository=\"andershfranzen/pluto-launcher\"}) - sum(pluto_github_release_downloads{repository=\"andershfranzen/pluto-launcher\"} offset 1d)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Time since successful collection",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(pluto_github_download_stats_last_success_timestamp_seconds{repository=\"andershfranzen/pluto-launcher\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 93600
              },
              {
                "color": "red",
                "value": 129600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Total APK downloads over time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pluto_github_apk_downloads_total{repository=\"andershfranzen/pluto-launcher\"})",
          "legendFormat": "All releases",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Downloads by release over time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (release) (pluto_github_apk_downloads_total{repository=\"andershfranzen/pluto-launcher\"})",
          "legendFormat": "{{release}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Current downloads by release",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 7
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(sum by (release) (pluto_github_release_downloads{repository=\"andershfranzen/pluto-launcher\"}))",
          "legendFormat": "{{release}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      }
    }
  ],
  "links": [
    {
      "title": "GitHub download report",
      "url": "https://github.com/andershfranzen/pluto-launcher/tree/download-stats",
      "targetBlank": true
    }
  ]
}
