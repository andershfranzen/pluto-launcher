[Unit]
Description=Collect Pluto GitHub APK download statistics
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=a5
ExecStart=/usr/bin/python3 /srv/docker/monitoring/pluto/collect/export-download-metrics.py --history /srv/docker/monitoring/pluto/history --metrics /var/lib/node_exporter/textfile_collector/pluto-downloads.prom
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/docker/monitoring/pluto/history /var/lib/node_exporter/textfile_collector
