    <!-- Optional permission disclosures -->
    <string name="settings_access_lock_title">Allow double-tap screen locking?</string>
    <string name="settings_access_notifications_title">Allow notification dots?</string>
    <string name="settings_access_lock_text">Pluto uses Android’s Accessibility Service API only to lock your screen when you double-tap empty space on Home. This service cannot read screen content and does not monitor accessibility events. It does not collect, store or share personal data. Screen locking is optional. You can turn off “Pluto screen lock” in Android’s Accessibility settings at any time.</string>
    <string name="settings_access_notifications_text">Android notification access lets Pluto receive notification information, including while Pluto is in the background. Pluto uses app and profile identifiers, notification flags and badge eligibility only to show dots. It does not read or store message text. The metadata stays in memory on your device and is never sent to a server. Notification dots are optional. You can revoke notification access in Android Settings at any time.</string>
    <string name="settings_access_agree">Agree and continue</string>

    <!-- Privacy policy -->
    <string name="settings_privacy_byline">Pluto Launcher · Anders (andershfranzen) · Updated 12 October 2026</string>
    <string name="settings_privacy_device_title">Your information stays on your device</string>
    <string name="settings_privacy_device_text">Pluto has no account, ads, analytics, tracking SDKs or remote crash reporting. The developer does not receive your installed-app list, layout, searches, ROMs, notifications or launch history.</string>
    <string name="settings_privacy_apps_title">Apps, layout and recent launches</string>
    <string name="settings_privacy_apps_text">Pluto reads launchable app names, icons and shortcuts to display and search them. Favourites, folders, hidden apps, categories, widget IDs and settings are saved in the app’s private storage. Optional recent launches are stored locally; you can clear them or turn history off in Settings. Search queries are used locally and are not saved as a search history.</string>
    <string name="settings_privacy_roms_title">ROM folders and artwork</string>
    <string name="settings_privacy_roms_text">Pluto accesses only folders and images you select with Android’s file picker. It saves file references, game names and artwork locally to build your library. Opening a game gives your chosen emulator access to its selected file. Removing a ROM tab deletes Pluto’s library records, not your game files. Emulators and widget providers handle their own data under their own policies.</string>
    <string name="settings_privacy_dots_title">Notification dots</string>
    <string name="settings_privacy_dots_text">Optional Android notification access is used for app/profile identifiers, notification flags and badge eligibility. This metadata is held only in memory, including in the background while access is enabled. Pluto does not read or store notification message text or send notification data off the device. Revoke access in Android Settings to stop the listener.</string>
    <string name="settings_privacy_lock_title">Double-tap screen locking</string>
    <string name="settings_privacy_lock_text">The optional Accessibility Service API is used only to perform Android’s lock-screen action after your double tap. It cannot retrieve screen content and does not subscribe to accessibility events. No personal data is collected, stored or shared through this service. Disable “Pluto screen lock” in Android’s Accessibility settings to revoke access.</string>
    <string name="settings_privacy_updates_title">Updates and external links</string>
    <string name="settings_privacy_updates_text">The Google Play build has no Internet permission or GitHub updater. Google Play handles its updates under Google’s own privacy policy. The GitHub build contacts GitHub only for update checks you permit and downloads you request. GitHub receives normal connection metadata, such as your IP address and Pluto version; no launcher activity is sent. Update checks are optional and downloads require your approval. External support links open in your browser and are subject to the destination’s privacy policy.</string>
    <string name="settings_privacy_retention_title">Retention and deletion</string>
    <string name="settings_privacy_retention_text">Pluto’s saved data remains in its private on-device storage until you remove it, clear the app’s storage or uninstall. Android backup is disabled. Revoking file permissions stops future access. Clearing Pluto’s storage does not delete the ROM files or artwork you selected. Pluto has no server account or server-held user records to delete.</string>
    <string name="settings_privacy_contact_title">Contact</string>
    <string name="settings_privacy_contact_text">For privacy questions, email anders@afive.dev. You can also report issues through the Pluto Launcher GitHub issue tracker. Avoid including private information in a public issue.</string>
    <string name="settings_privacy_email">Email the developer</string>
    <string name="settings_privacy_website">View public privacy policy</string>

