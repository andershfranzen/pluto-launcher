    <!-- Optional permission disclosures -->
    <string name="settings_access_lock_title">要允许点按两次锁屏吗？</string>
    <string name="settings_access_notifications_title">要允许显示通知圆点吗？</string>
    <string name="settings_access_lock_text">Pluto 仅在你于主屏幕空白处点按两次时，使用 Android 的无障碍服务 API 来锁定屏幕。此服务无法读取屏幕内容，也不会监控无障碍事件。它不会收集、存储或分享个人数据。锁屏功能是可选的。你可以随时在 Android 的无障碍设置中关闭“Pluto 锁屏”。</string>
    <string name="settings_access_notifications_text">Android 通知使用权可让 Pluto 接收通知信息，包括 Pluto 在后台运行时。Pluto 仅使用应用和资料标识符、通知标志以及标记资格来显示圆点，不会读取或存储消息文本。这些元数据仅保留在你设备的内存中，绝不会发送到服务器。通知圆点是可选的。你可以随时在 Android 设置中撤消通知使用权。</string>
    <string name="settings_access_agree">同意并继续</string>

    <!-- Privacy policy -->
    <string name="settings_privacy_byline">Pluto Launcher · Anders (andershfranzen) · 更新于 2026 年 10 月 12 日</string>
    <string name="settings_privacy_device_title">你的信息保留在你的设备上</string>
    <string name="settings_privacy_device_text">Pluto 没有账号、广告、分析、跟踪 SDK 或远程崩溃报告。开发者不会收到你的已安装应用列表、布局、搜索内容、ROM、通知或启动历史记录。</string>
    <string name="settings_privacy_apps_title">应用、布局和最近启动</string>
    <string name="settings_privacy_apps_text">Pluto 会读取可启动应用的名称、图标和快捷方式，以便显示和搜索它们。收藏、文件夹、隐藏的应用、分类、微件 ID 和设置都保存在应用的私有存储空间中。可选的最近启动记录存储在本地；你可以在“设置”中清除这些记录或关闭历史记录。搜索查询仅在本地使用，不会保存为搜索历史记录。</string>
    <string name="settings_privacy_roms_title">ROM 文件夹和封面图</string>
    <string name="settings_privacy_roms_text">Pluto 只会访问你通过 Android 文件选择器选择的文件夹和图片。它会在本地保存文件引用、游戏名称和封面图，用于构建你的游戏库。打开游戏时，你选择的模拟器将获得对所选文件的访问权限。移除 ROM 标签页只会删除 Pluto 的游戏库记录，不会删除你的游戏文件。模拟器和微件提供方会按照各自的政策处理其自身的数据。</string>
    <string name="settings_privacy_dots_title">通知圆点</string>
    <string name="settings_privacy_dots_text">可选的 Android 通知使用权用于获取应用/资料标识符、通知标志和标记资格。这些元数据仅保留在内存中，包括在启用访问权限期间于后台运行时。Pluto 不会读取或存储通知消息文本，也不会将通知数据发送到设备之外。在 Android 设置中撤消访问权限即可停止监听。</string>
    <string name="settings_privacy_lock_title">点按两次锁屏</string>
    <string name="settings_privacy_lock_text">可选的无障碍服务 API 仅用于在你点按两次后执行 Android 的锁屏操作。它无法获取屏幕内容，也不会订阅无障碍事件。此服务不会收集、存储或分享任何个人数据。在 Android 的无障碍设置中停用“Pluto 锁屏”即可撤消访问权限。</string>
    <string name="settings_privacy_updates_title">更新和外部链接</string>
    <string name="settings_privacy_updates_text">Google Play 版本没有互联网权限，也没有 GitHub 更新程序。Google Play 会按照 Google 自己的隐私权政策处理更新。GitHub 版本仅在你允许的更新检查和你请求的下载时连接 GitHub。GitHub 会收到常规的连接元数据，例如你的 IP 地址和 Pluto 版本；不会发送任何启动器活动信息。更新检查是可选的，下载需要你批准。外部支持链接会在你的浏览器中打开，并受目标网站隐私权政策的约束。</string>
    <string name="settings_privacy_retention_title">保留和删除</string>
    <string name="settings_privacy_retention_text">Pluto 保存的数据会保留在其设备上的私有存储空间中，直到你将其移除、清除应用存储空间或卸载应用。Android 备份已停用。撤消文件权限后将无法再进行访问。清除 Pluto 的存储空间不会删除你选择的 ROM 文件或封面图。Pluto 没有服务器账号，也没有保存在服务器上、需要删除的用户记录。</string>
    <string name="settings_privacy_contact_title">联系方式</string>
    <string name="settings_privacy_contact_text">如有隐私方面的问题，请发送电子邮件至 anders@afive.dev。你也可以通过 Pluto Launcher 的 GitHub 问题跟踪器报告问题。请勿在公开问题中包含私人信息。</string>
    <string name="settings_privacy_email">给开发者发送电子邮件</string>
    <string name="settings_privacy_website">查看公开的隐私权政策</string>

